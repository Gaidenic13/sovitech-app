# Local development settings. Copy this file to .env (git-ignored) and choose your
# own values; never commit .env. Used by docker-compose.yml and by
# `pnpm --filter @sovitech/db migrate`. Tests do not read it.

# The Postgres superuser of the local container: the database administrator.
SOVITECH_DB_ADMINISTRATOR_USER=sovitech_administrator
SOVITECH_DB_ADMINISTRATOR_PASSWORD=
SOVITECH_DB_NAME=sovitech
# Host port on 127.0.0.1 (5433, so a Postgres already on 5432 is left alone).
SOVITECH_DB_PORT=5433

# Passwords the migration runner sets for the login roles (12 characters or more).
SOVITECH_DB_MIGRATOR_PASSWORD=
SOVITECH_DB_APP_PASSWORD=
SOVITECH_DB_OPERATOR_PASSWORD=

# The Anthropic API key for fixture-only evals and AI recordings (the owner's
# answer, 2026-09-25; docs/adr/0021-anthropic-sdk-and-model.md). Put the real
# key only in .env (git-ignored). The AI boundary reads this one variable from
# the environment or .env, never logs or writes it, and sends only fixture
# content. Left empty, the evals report "not running".
ANTHROPIC_API_KEY=

# The API and the analysis worker (phase 2; docs/adr/0025, 0026). The data folder
# holds every stored file under <projectId>/<contentHash>/ and must lie outside the
# repository; left empty, it is the application-support folder of this machine
# (macOS: ~/Library/Application Support/SOVITECH App/data). The session secret signs
# the session and CSRF cookies (32 characters or more). The extraction account is
# the service account `pnpm --filter @sovitech/api extraction-account` creates.
SOVITECH_DATA_DIR=
SOVITECH_SESSION_SECRET=
SOVITECH_EXTRACTION_ACCOUNT_ID=
SOVITECH_EXTRACTOR_IMAGE=sovitech-extractor:dev
# The IFC reader's sandbox image (web-ifc; docs/adr/0031), built with
# `docker build -f services/ifc-reader/Dockerfile -t sovitech-ifc-reader:dev .`
SOVITECH_IFC_READER_IMAGE=sovitech-ifc-reader:dev
# The viewer step (owner decision D-03, 2026-10-05): the model conversion sandbox image,
# built with `services/model-converter/build.sh` (labelled with its sources' hash; the
# worker refuses an image built from other sources with the code `stale_image`).
SOVITECH_CONVERTER_IMAGE=sovitech-model-converter:dev

# Phase 3 (docs/adr/0037-e2e-setup.md): whole connection strings for the app's and the
# operator's logins. When set they win over the port, name and passwords above (the e2e
# setup sets them to its TEST database); left empty, those are used.
SOVITECH_DB_APP_URL=
SOVITECH_DB_OPERATOR_URL=
# Phase 3 (docs/adr/0038-development-login.md): the development accounts the sign-in page
# offers, comma-separated ids, as `pnpm --filter @sovitech/api dev-accounts` prints them.
# Left empty, the development login is off. It is also off whenever the API accepts files
# that are not the synthetic fixtures (it is never on where real owner documents are stored).
SOVITECH_DEV_ACCOUNTS=
# Phase 3 part B (docs/adr/0038-development-login.md, decision 9): how long a session lives
# unused, in minutes (1 to 1440), and in all, in hours (1 to 168). Left empty: 30 minutes
# unused and 12 hours in all. The idle lifetime may not be longer than the absolute one.
SOVITECH_SESSION_IDLE_MINUTES=
SOVITECH_SESSION_ABSOLUTE_HOURS=

# Phase 5 (docs/adr/0050-exports-print-route-and-pdf.md): the web origin the API prints the proposal PDF from, on the
# loopback interface only (dev: the Vite origin, http://127.0.0.1:5173; e2e: set by the e2e setup). Empty: exports
# answer "export_unavailable".
SOVITECH_WEB_ORIGIN=
