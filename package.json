{
  "name": "sovitech-app",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "check": "tsx tools/check.ts",
    "check:selftest": "tsx tools/checks/run-all.ts --self-test",
    "checks": "tsx tools/checks/run-all.ts",
    "lint": "pnpm run lint:eslint && pnpm run lint:deps",
    "lint:eslint": "eslint --max-warnings 0 .",
    "lint:deps": "tsx tools/checks/scan-roots/lint-deps.ts",
    "typecheck": "pnpm run typecheck:packages && pnpm run typecheck:root",
    "typecheck:packages": "pnpm -r --no-bail run typecheck",
    "typecheck:root": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:py": "cd services/extractor && .venv/bin/ruff check . && .venv/bin/ruff format --check . && .venv/bin/ruff check --no-cache --config pyproject.toml ../../fixtures/generators && .venv/bin/ruff format --no-cache --check --config pyproject.toml ../../fixtures/generators && .venv/bin/pytest -q",
    "test:render": "tsx tools/run-render.ts",
    "test:proposed": "vitest run --config vitest.proposed.config.ts",
    "evals": "tsx packages/ai/src/evals/cli.ts",
    "fixtures:regenerate": "tsx tools/regenerate-fixtures.ts",
    "fixtures:sandbox": "tsx tools/regenerate-fixtures.ts --sandbox",
    "e2e": "playwright test",
    "setup:py": "python3.12 -m venv --clear services/extractor/.venv && services/extractor/.venv/bin/python -m pip install --disable-pip-version-check --require-hashes --only-binary=:all: -r services/extractor/requirements-dev.lock",
    "dev:web": "pnpm --filter @sovitech/web run dev",
    "dev:api": "pnpm --filter @sovitech/api run dev"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/css": "2.0.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@sovitech/ai": "workspace:*",
    "@sovitech/api": "workspace:*",
    "@sovitech/db": "workspace:*",
    "@sovitech/domain": "workspace:*",
    "@sovitech/engine": "workspace:*",
    "@sovitech/extraction-contract": "workspace:*",
    "@sovitech/ifc-reader": "workspace:*",
    "@sovitech/registry": "workspace:*",
    "@sovitech/ui": "workspace:*",
    "@sovitech/view-model": "workspace:*",
    "@sovitech/viewer": "workspace:*",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.1",
    "decimal.js": "10.6.0",
    "dependency-cruiser": "18.4.0",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.10.2",
    "fastify": "5.12.5",
    "globals": "17.12.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "tinyglobby": "0.2.17",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  }
}
